{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "ui",
  "description": "The browser's own interface: toolbar, tabs and panels.",
  "webviews": [
    "ui"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-ui-ready",
    "allow-tab-new",
    "allow-tab-close",
    "allow-tab-activate",
    "allow-tab-navigate",
    "allow-tab-back",
    "allow-tab-forward",
    "allow-tab-reload",
    "allow-tab-stop",
    "allow-tab-text-mode",
    "allow-layout",
    "allow-net-set",
    "allow-net-status",
    "allow-ads-set",
    "allow-media-download",
    "allow-probe-preview",
    "allow-download-cancel",
    "allow-download-open-folder",
    "allow-clear-browsing-data",
    "allow-prefs-set",
    "core:window:allow-start-dragging",
    "core:window:allow-start-resize-dragging",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-is-maximized",
    "allow-download-pause",
    "allow-download-resume",
    "allow-download-open",
    "allow-download-show",
    "allow-media-preview",
    "allow-media-thumb",
    "allow-settings-view",
    "allow-settings-set",
    "allow-settings-export",
    "allow-settings-import",
    "allow-filters-update",
    "allow-filters-rules-set",
    "allow-tools-view",
    "allow-tools-update",
    "allow-cache-clear",
    "allow-scripts-view",
    "allow-script-install",
    "allow-script-toggle",
    "allow-script-remove",
    "allow-script-update",
    "allow-script-menu-run",
    "allow-script-answer",
    "allow-link-resolve",
    "allow-link-open-vip",
    "allow-bypass-key-set",
    "allow-extension-add",
    "allow-extension-remove"
  ]
}
